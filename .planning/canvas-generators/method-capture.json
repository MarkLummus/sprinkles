:"0px none","pad":"0px","tt":"none","ls":"normal","deco":"none","maxW":"none","w":167,"h":19},"chip":{"face":"-apple-system","size":"12px","weight":"400","style":"normal","lh":"14.4px","color":"rgb(20, 20, 20)","mt":"2px","mb":"0px","ml":"8px","bl":"1px solid","bb":"1px solid","border":"1px solid","pad":"0px 6px","tt":"none","ls":"normal","deco":"none","maxW":"none","w":67,"h":16},"chipLabel":{"face":"-apple-system","size":"12px","weight":"400","style":"normal","lh":"normal","color":"rgb(20, 20, 20)","mt":"0px","mb":"0px","ml":"0px","bl":"0px none","bb":"0px none","border":"0px none","pad":"0px","tt":"none","ls":"normal","deco":"none","maxW":"none","w":28,"h":14},"chipValue":{"face":"-apple-system","size":"12px","weight":"400","style":"normal","lh":"14.4px","color":"rgb(20, 20, 20)","mt":"0px","mb":"0px","ml":"0px","bl":"0px none","bb":"0px none","border":"0px none","pad":"0px","tt":"none","ls":"normal","deco":"none","maxW":"none","w":53,"h":14},"purpose":{"face":"Georgia","size":"13px","weight":"400","style":"italic","lh":"normal","color":"rgb(20, 20, 20)","mt":"6px","mb":"0px","ml":"0px","bl":"0px none","bb":"0px none","border":"0px none","pad":"0px","tt":"none","ls":"normal","deco":"none","maxW":"518.635px","w":519,"h":15},"aside":{"face":"Georgia","size":"13px","weight":"400","style":"italic","lh":"normal","color":"rgb(20, 20, 20)","mt":"6px","mb":"0px","ml":"0px","bl":"0px none","bb":"0px none","border":"0px none","pad":"0px","tt":"none","ls":"normal","deco":"none","maxW":"518.635px","w":519,"h":30},"step":{"face":"-apple-system","size":"15px","weight":"400","style":"normal","lh":"normal","color":"rgb(20, 20, 20)","mt":"0px","mb":"0px","ml":"0px","bl":"0px none","bb":"0px none","border":"0px none","pad":"0px","tt":"none","ls":"normal","deco":"none","maxW":"none","w":725,"h":81},"heading":{"face":"-apple-system","size":"14px","weight":"600","style":"normal","lh":"18.9px","color":"rgb(51, 81, 59)","mt":"0px","mb":"6px","ml":"0px","bl":"0px none","bb":"0px none","border":"0px none","pad":"0px","tt":"uppercase","ls":"0.56px","deco":"none","maxW":"none","w":725,"h":19},"steps":10,"withPurpose":3,"withAside":5,"withTargets":10,"chips":21},"chromium_print696":{"regionW":656,"regionH":972,"steps":[81,96,79,113,113,81,41,81,41,41],"headingH":19,"breakInside":"avoid"},"chromium_print652":{"regionW":612,"regionH":1010,"steps":[81,115,79,113,132,81,41,81,41,41],"headingH":19,"breakInside":"avoid"}},"article":"<article class=\"recipe-page\"><div class=\"recipe-band\"><header class=\"headnote\"><h1>Olive Oil Ice Cream</h1><p class=\"headnote__prose\">Silky and quietly savoury. Fresh olive oil adds a gentle fruitiness without overwhelming the cream, and a little more salt than you would think carries it. Serve it soft, with flaky salt.</p></header></div><section class=\"before-region\" aria-label=\"Before you start\"><h2 class=\"region-name\">Before you start</h2><ul class=\"authored__notes\"><li>Taste the Graza straight. Polyphenols degrade with light and oxygen, and the squeeze bottle offers less protection than dark glass. An old bottle at 40 g will disappear entirely.</li><li>Check the cream’s actual butterfat. The carton states a 36% minimum, which is a floor.</li></ul></section><section class=\"ingredient-table-region\" aria-label=\"Ingredients\"><h2 class=\"region-name\">Ingredients</h2><table class=\"ingredient-table\"><thead><tr><th scope=\"col\" class=\"ingredient-table__col-name\" colspan=\"2\">Ingredient</th><th scope=\"col\" class=\"ingredient-table__col-numeric\">% of batch</th></tr></thead><tbody><tr class=\"ingredient-table__step-head\"><td colspan=\"3\">Step 2<span class=\"ingredient-table__step-head-lead\">Gum slurry — the only high-heat step</span></td></tr><tr aria-label=\"Whole milk, 370.4 g, estimated\"><td class=\"ingredient-table__col-grams\"><span class=\"ingredient-table__plan-grams\">120 g</span></td><td class=\"ingredient-table__col-name\">Whole milk<span class=\"target-chip ingredient-table__flag\"><span class=\"target-chip__value\">estimated</span></span><span class=\"ingredient-table__portion-note\">120 g of 370.4 g · 46.3% in all</span></td><td class=\"ingredient-table__col-numeric\">15.0%</td></tr><tr aria-label=\"Sucrose, 76 g\"><td class=\"ingredient-table__col-grams\"><span class=\"ingredient-table__plan-grams\">12 g</span></td><td class=\"ingredient-table__col-name\">Sucrose<span class=\"ingredient-table__portion-note\">12 g of 76.0 g · 9.5% in all</span></td><td class=\"ingredient-table__col-numeric\">1.5%</td></tr><tr aria-label=\"Locust bean gum, 1.04 g\"><td class=\"ingredient-table__col-grams\"><span class=\"ingredient-table__plan-grams\">1.04 g</span></td><td class=\"ingredient-table__col-name\">Locust bean gum</td><td class=\"ingredient-table__col-numeric\">0.1%</td></tr><tr aria-label=\"Guar gum, 0.48 g\"><td class=\"ingredient-table__col-grams\"><span class=\"ingredient-table__plan-grams\">0.48 g</span></td><td class=\"ingredient-table__col-name\">Guar gum</td><td class=\"ingredient-table__col-numeric\">0.1%</td></tr><tr aria-label=\"Lambda carrageenan, 0.16 g\"><td class=\"ingredient-table__col-grams\"><span class=\"ingredient-table__plan-grams\">0.16 g</span></td><td class=\"ingredient-table__col-name\">Lambda carrageenan</td><td class=\"ingredient-table__col-numeric\">trace</td></tr></tbody><tbody><tr class=\"ingredient-table__step-head\"><td colspan=\"3\">Step 3<span class=\"ingredient-table__step-head-lead\">Build the base</span></td></tr><tr aria-label=\"Whole milk, 370.4 g, estimated\"><td class=\"ingredient-table__col-grams\"><span class=\"ingredient-table__plan-grams\">250.4 g</span></td><td class=\"ingredient-table__col-name\">Whole milk<span class=\"target-chip ingredient-table__flag\"><span class=\"target-chip__value\">estimated</span></span><span class=\"ingredient-table__portion-note\">250.4 g of 370.4 g · 46.3% in all</span></td><td class=\"ingredient-table__col-numeric\">31.3%</td></tr><tr aria-label=\"Heavy cream, 252.8 g, estimated\"><td class=\"ingredient-table__col-grams\"><span class=\"ingredient-table__plan-grams\">252.8 g</span></td><td class=\"ingredient-table__col-name\">Heavy cream<span class=\"target-chip ingredient-table__flag\"><span class=\"target-chip__value\">estimated</span></span></td><td class=\"ingredient-table__col-numeric\">31.6%</td></tr><tr aria-label=\"Skim milk powder, 22.4 g\"><td class=\"ingredient-table__col-grams\"><span class=\"ingredient-table__plan-grams\">22.4 g</span></td><td class=\"ingredient-table__col-name\">Skim milk powder</td><td class=\"ingredient-table__col-numeric\">2.8%</td></tr><tr aria-label=\"Sucrose, 76 g\"><td class=\"ingredient-table__col-grams\"><span class=\"ingredient-table__plan-grams\">64 g</span></td><td class=\"ingredient-table__col-name\">Sucrose<span class=\"ingredient-table__portion-note\">64 g of 76.0 g · 9.5% in all</span></td><td class=\"ingredient-table__col-numeric\">8.0%</td></tr><tr aria-label=\"Dextrose, 12 g\"><td class=\"ingredient-table__col-grams\"><span class=\"ingredient-table__plan-grams\">12 g</span></td><td class=\"ingredient-table__col-name\">Dextrose</td><td class=\"ingredient-table__col-numeric\">1.5%</td></tr><tr aria-label=\"Fine sea salt, 3.2 g, estimated\"><td class=\"ingredient-table__col-grams\"><span class=\"ingredient-table__plan-grams\">3.2 g</span></td><td class=\"ingredient-table__col-name\">Fine sea salt<span class=\"target-chip ingredient-table__flag\"><span class=\"target-chip__value\">estimated</span></span></td><td class=\"ingredient-table__col-numeric\">0.4%</td></tr></tbody><tbody><tr class=\"ingredient-table__step-head\"><td colspan=\"3\">Step 6<span class=\"ingredient-table__step-head-lead\">Allulose in, then crash-cool</span></td></tr><tr aria-label=\"Allulose, 20 g, estimated\"><td class=\"ingredient-table__col-grams\"><span class=\"ingredient-table__plan-grams\">20 g</span></td><td class=\"ingredient-table__col-name\">Allulose<span class=\"target-chip ingredient-table__flag\"><span class=\"target-chip__value\">estimated</span></span></td><td class=\"ingredient-table__col-numeric\">2.5%</td></tr></tbody><tbody><tr class=\"ingredient-table__step-head\"><td colspan=\"3\">Step 8<span class=\"ingredient-table__step-head-lead\">Emulsify the oil, cold</span></td></tr><tr aria-label=\"Graza Drizzle, 40 g\"><td class=\"ingredient-table__col-grams\"><span class=\"ingredient-table__plan-grams\">40 g</span></td><td class=\"ingredient-table__col-name\">Graza Drizzle</td><td class=\"ingredient-table__col-numeric\">5.0%</td></tr><tr aria-label=\"Soy lecithin, 1.2 g\"><td class=\"ingredient-table__col-grams\"><span class=\"ingredient-table__plan-grams\">1.2 g</span></td><td class=\"ingredient-table__col-name\">Soy lecithin</td><td class=\"ingredient-table__col-numeric\">0.2%</td></tr></tbody><tfoot><tr aria-label=\"Total, plan 799.7 grams\"><td class=\"ingredient-table__col-grams\"><span class=\"ingredient-table__plan-grams\">799.7 g</span></td><td class=\"ingredient-table__col-name\">Total</td><td class=\"ingredient-table__col-numeric\"></td></tr></tfoot></table></section><section class=\"method-region\" aria-label=\"Instructions\"><h2 class=\"region-name\">Instructions</h2><ol class=\"method-steps\"><li id=\"method-step-1\" class=\"method-step\"><span class=\"method-step__n\" aria-hidden=\"true\">1</span><div class=\"method-step__body\"><p class=\"method-step__lead\"><span><b>Lecithin into the oil.</b> Whisk 1.2 g soy lecithin into the 40 g of Drizzle. Cover, leave at room temperature.</span></p><p class=\"method-step__targets\"><span class=\"target-chip\"><span class=\"target-chip__label\">temp</span><span class=\"target-chip__value\">room</span></span></p><p class=\"method-step__purpose\">It's lipophilic — it disperses poorly if added to the water phase.</p></div></li><li id=\"method-step-2\" class=\"method-step\"><span class=\"method-step__n\" aria-hidden=\"true\">2</span><div class=\"method-step__body\"><p class=\"method-step__lead\"><span><b>Gum slurry — the only high-heat step.</b> Toss 1.68 g of the gum blend with the sucrose. Whisk into the milk in a small saucepan. Heat, whisking constantly, then pull off.</span></p><p class=\"method-step__targets\"><span class=\"target-chip\"><span class=\"target-chip__label\">temp</span><span class=\"target-chip__value\">85 °C</span></span><span class=\"target-chip\"><span class=\"target-chip__label\">hold</span><span class=\"target-chip__value\">2 min</span></span></p><p class=\"method-step__aside\">At 120 g this is a thin layer in the pan. It scorches and evaporates faster than a larger volume would — keep whisking and don’t walk away.</p></div></li><li id=\"method-step-3\" class=\"method-step\"><span class=\"method-step__n\" aria-hidden=\"true\">3</span><div class=\"method-step__body\"><p class=\"method-step__lead\"><span><b>Build the base.</b> Whisk the remaining sucrose, plus 22.4 g SMP, 12 g dextrose and 3.2 g salt, into the remaining milk and all 252.8 g of cream. Add the hot gum slurry. Immersion blend.</span></p><p class=\"method-step__targets\"><span class=\"target-chip\"><span class=\"target-chip__label\">blend</span><span class=\"target-chip__value\">60 s</span></span></p></div></li><li id=\"method-step-4\" class=\"method-step\"><span class=\"method-step__n\" aria-hidden=\"true\">4</span><div class=\"method-step__body\"><p class=\"method-step__lead\"><span><b>Divide.</b> Tare, pour, check.</span></p><p class=\"method-step__targets\"><span class=\"target-chip\"><span class=\"target-chip__label\">per jar</span><span class=\"target-chip__value\">379 g</span></span></p><p class=\"method-step__purpose\">Mismatched jars hit core temperature at different times and you would be timing off the wrong one.</p><p class=\"method-step__aside\">Two-piece lids finger-tight only — the headspace air expands and needs to vent rather than build pressure.</p></div></li><li id=\"method-step-5\" class=\"method-step\"><span class=\"method-step__n\" aria-hidden=\"true\">5</span><div class=\"method-step__body\"><p class=\"method-step__lead\"><span><b>Pasteurise in the circulator.</b> Start the clock when the jar core reaches temperature.</span></p><p class=\"method-step__targets\"><span class=\"target-chip\"><span class=\"target-chip__label\">temp</span><span class=\"target-chip__value\">69 °C</span></span><span class=\"target-chip\"><span class=\"target-chip__label\">hold</span><span class=\"target-chip__value\">40 min</span></span><span class=\"target-chip\"><span class=\"target-chip__label\">come-up</span><span class=\"target-chip__value\">10–12 min</span></span></p><p class=\"method-step__purpose\">With 379 g in a squat wide-mouth jar the come-up is much faster than a single large vessel.</p><p class=\"method-step__aside\">Probe the core rather than trusting the estimate. Invert each jar once or twice partway through.</p></div></li><li id=\"method-step-6\" class=\"method-step\"><span class=\"method-step__n\" aria-hidden=\"true\">6</span><div class=\"method-step__body\"><p class=\"method-step__lead\"><span><b>Allulose in, then crash-cool.</b> Combine both jars, stir in the 20 g allulose off the heat until dissolved, then straight into an ice bath.</span></p><p class=\"method-step__targets\"><span class=\"target-chip\"><span class=\"target-chip__label\">to</span><span class=\"target-chip__value\">below 5 °C</span></span></p><p class=\"method-step__aside\">Allulose skips the hold — it browns readily with milk proteins.</p></div></li><li id=\"method-step-7\" class=\"method-step\"><span class=\"method-step__n\" aria-hidden=\"true\">7</span><div class=\"method-step__body\"><p class=\"method-step__lead\"><span><b>Age.</b> Hold covered in the fridge.</span></p><p class=\"method-step__targets\"><span class=\"target-chip\"><span class=\"target-chip__label\">temp</span><span class=\"target-chip__value\">4 °C</span></span><span class=\"target-chip\"><span class=\"target-chip__label\">time</span><span class=\"target-chip__value\">12–24 h</span></span></p></div></li><li id=\"method-step-8\" class=\"method-step\"><span class=\"method-step__n\" aria-hidden=\"true\">8</span><div class=\"method-step__body\"><p class=\"method-step__lead\"><span><b>Emulsify the oil, cold.</b> Mix still at 4 °C. Pour the lecithin-oil blend in a thin stream under a running immersion blender.</span></p><p class=\"method-step__targets\"><span class=\"target-chip\"><span class=\"target-chip__label\">temp</span><span class=\"target-chip__value\">4 °C</span></span><span class=\"target-chip\"><span class=\"target-chip__label\">blend</span><span class=\"target-chip__value\">45 s</span></span></p><p class=\"method-step__aside\">Never heat this oil.</p></div></li><li id=\"method-step-9\" class=\"method-step\"><span class=\"method-step__n\" aria-hidden=\"true\">9</span><div class=\"method-step__body\"><p class=\"method-step__lead\"><span><b>Churn.</b> Freeze immediately.</span></p><p class=\"method-step__targets\"><span class=\"target-chip\"><span class=\"target-chip__label\">overrun</span><span class=\"target-chip__value\">25–30%</span></span></p></div></li><li id=\"method-step-10\" class=\"method-step\"><span class=\"method-step__n\" aria-hidden=\"true\">10</span><div class=\"method-step__body\"><p class=\"method-step__lead\"><span><b>Harden, and serve warm.</b> Harden, then temper before serving.</span></p><p class=\"method-step__targets\"><span class=\"target-chip\"><span class=\"target-chip__label\">harden</span><span class=\"target-chip__value\">−20 °C, 4+ h</span></span><span class=\"target-chip\"><span class=\"target-chip__label\">serve</span><span class=\"target-chip__value\">−11 to −12 °C</span></span></p></div></li></ol></section><div class=\"side-region\"><section class=\"formulation-note-region\" aria-label=\"Balance\"><h2 class=\"region-name\"><button type=\"button\" class=\"fold-row\" aria-expanded=\"true\" aria-controls=\"fold-balance\" aria-label=\"Balance, Hide\" tabindex=\"0\"><span class=\"fold-row__head\">Balance<span class=\"fold-row__control\